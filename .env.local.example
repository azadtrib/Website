# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored on purpose.

# Stripe (Developers -> API keys in the Stripe dashboard).
# Use sk_test_/pk_test_ keys while testing, sk_live_/pk_live_ when live.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# The public URL of the site. Used for canonical URLs, the sitemap and
# social share previews. Must be the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) — sends order confirmation, new-order and
# out-for-delivery emails. See README "Sending order emails".
RESEND_API_KEY=re_...

# Where new-order notifications go (defaults to siteConfig.supportEmail).
OWNER_EMAIL=you@example.com

# Verified Resend sender, e.g. "AZAD BLACK <orders@azadblack.co.uk>".
# Until the domain is verified, leave this unset to use Resend's test sender.
EMAIL_FROM=

# Stripe webhook signing secret (Developers -> Webhooks -> your endpoint).
STRIPE_WEBHOOK_SECRET=whsec_...

# Password for the /admin orders page, and a random secret to sign its session
# cookie (generate with: openssl rand -hex 32).
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=
